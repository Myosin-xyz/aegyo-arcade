# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Test artifacts
test-results/
playwright-report/

# Claw design master stays in shared storage, not git
*.psd

# Raw external game deliveries stay OUT of git (archive lives in Myosin
# shared storage per GAME_INTAKE.md); only migrated code/assets are committed.
/files_freebie_frenzy/
/cross-to-the-concert/
/intake/
# Bias Flap handoff parked at the repo root (2026-07-27); the canonical
# hash-recorded copy lives in intake/bias-flap. Ignoring it also keeps
# `prettier --write .` (which respects .gitignore) from reformatting the
# delivery's bytes — that ALREADY happened once and was restored.
/bias-flap/

# Source art for the claw pipeline (read by scripts/export-claw-layers.py; only built webp ships)
intake/
